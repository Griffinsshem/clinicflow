# Server-side only — NOT prefixed with NEXT_PUBLIC_.
#
# The browser talks to /api/proxy on this origin, never to Flask
# directly, so the backend URL stays out of the client bundle entirely.
API_URL=http://localhost:5000/api/v1

# Shared with the Flask API (same value as its PROXY_SHARED_SECRET).
# Lets the API rate-limit by each visitor's real IP instead of by this
# server's IP. Required in production; optional for local development.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PROXY_SHARED_SECRET=
