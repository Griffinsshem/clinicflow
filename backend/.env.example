# Copy to .env and fill in. NEVER commit .env.

FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# psycopg3 requires the +psycopg scheme suffix
DATABASE_URL=postgresql+psycopg://clinicflow:password@localhost:5432/clinicflow_dev
TEST_DATABASE_URL=postgresql+psycopg://clinicflow:password@localhost:5432/clinicflow_test

# Comma-separated. No wildcards, ever.
CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Set true to expose POST /api/v1/demo (one-click demo clinics)
DEMO_ENABLED=true
